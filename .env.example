# Provider-neutral LLM access. Select one chat provider and, separately, the
# provider used to build/query embeddings. DeepSeek can be used for chat while
# keeping OPENAI embeddings, so comparing answers does not require re-indexing.
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4o
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# OpenAI. Omit OPENAI_BASE_URL for the public API; set it only for an approved compatible gateway.
OPENAI_API_KEY=

# Embedding throughput. The defaults stay below the OpenAI free-tier 40k TPM limit.
EMBEDDING_BATCH_TOKEN_BUDGET=10000
EMBEDDING_TOKENS_PER_MINUTE=30000
EMBEDDING_BATCH_MAX_RETRIES=4
EMBEDDING_RETRY_BASE_DELAY_SECONDS=2

# DeepSeek chat. Configure CHAT_MODEL to a model enabled for your account.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen / DashScope. DASHSCOPE_API_KEY may be used instead of QWEN_API_KEY.
# Set QWEN_BASE_URL to your region/workspace endpoint when it differs.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Local email/password login is required for this workspace.
AUTH_REQUIRED=true

# Set a long random value for AUTH_SECRET and a strong, unique bootstrap password.
# The application rejects a missing or unchanged placeholder secret at startup.
# Optional: leave blank to enable normal self-registration on a local workspace.
AUTH_SECRET=replace-with-a-unique-long-random-secret-before-sharing
ALLOW_SELF_REGISTRATION=true
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_DEPARTMENT=DDIT

# Optional department administrators. Leave blank to use only LOCAL_ADMIN_*.
DDIT_ADMIN_EMAIL=
DDIT_ADMIN_PASSWORD=
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# Keep diagram pages as source evidence. Set to true only when visual-model
# interpretation has been explicitly evaluated and approved for the workspace.
ENABLE_VISUAL_ANALYSIS=false

# Maximum source-document size accepted by the API. 50 MB accommodates the
# ABB AMR T702 public Product Manual used in the local evaluation runbook.
MAX_UPLOAD_SIZE_MB=50

# Redis/RQ is required for asynchronous, item-level URS analysis.
REDIS_URL=redis://localhost:16379/0
ANALYSIS_QUEUE_NAME=design-review
DOCUMENT_INDEX_QUEUE_NAME=document-indexing
DOCUMENT_INDEX_JOB_TIMEOUT_SECONDS=1800
DOCUMENT_INDEX_QUEUED_TIMEOUT_SECONDS=900
DOCUMENT_INDEX_STALE_AFTER_SECONDS=2100
DOCUMENT_INDEX_MAX_ATTEMPTS=3
# Lost parse jobs become visible failures; operators reparse preserved sources.
# Keep above the ingestion RQ job timeout (1800 seconds).
DOCUMENT_PARSE_STALE_AFTER_SECONDS=3600
ANALYSIS_ITEM_MAX_ATTEMPTS=3
# Comma-separated values are accepted by pydantic-settings for list fields.
ANALYSIS_RETRY_DELAYS_SECONDS=[2,5]
ANALYSIS_LEASE_SECONDS=360
ANALYSIS_HEARTBEAT_INTERVAL_SECONDS=30
ANALYSIS_MAINTENANCE_POLL_SECONDS=2
WORKER_BUILD_VERSION=local
# Frozen on each new HTTP review run. ranked_chunks_v1 restores legacy Top10.
REVIEW_EVIDENCE_SELECTION_POLICY=source_table_groups_v1
