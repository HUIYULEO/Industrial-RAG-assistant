# Provider-neutral LLM access. Select one chat provider and, separately, the
# provider used to build/query embeddings. DeepSeek can be used for chat while
# keeping OPENAI embeddings, so comparing answers does not require re-indexing.
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4o
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# OpenAI. OPENAI_BASE_URL is optional (for an approved compatible gateway).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# DeepSeek chat. Configure CHAT_MODEL to a model enabled for your account.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen / DashScope. DASHSCOPE_API_KEY may be used instead of QWEN_API_KEY.
# Set QWEN_BASE_URL to your region/workspace endpoint when it differs.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Local email/password login is enabled by default. Set a unique long secret before sharing.
AUTH_REQUIRED=true

# Required only when AUTH_REQUIRED=true. Use a long random value for AUTH_SECRET
# and a strong, unique bootstrap password. These values are never committed.
# Optional: leave blank to enable normal self-registration on a local workspace.
AUTH_SECRET=replace-with-a-unique-long-random-secret-before-sharing
ALLOW_SELF_REGISTRATION=true
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_DEPARTMENT=DDIT

# Optional department administrators. Leave blank to use only LOCAL_ADMIN_*.
DDIT_ADMIN_EMAIL=
DDIT_ADMIN_PASSWORD=
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# Keep diagram pages as source evidence. Set to true only when visual-model
# interpretation has been explicitly evaluated and approved for the workspace.
ENABLE_VISUAL_ANALYSIS=false

# Redis/RQ is required for asynchronous, item-level URS analysis.
REDIS_URL=redis://localhost:6379/0
ANALYSIS_QUEUE_NAME=design-review
ANALYSIS_ITEM_MAX_ATTEMPTS=3
# Comma-separated values are accepted by pydantic-settings for list fields.
ANALYSIS_RETRY_DELAYS_SECONDS=[2,5]
