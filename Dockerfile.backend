# Use uv to install the locked Python dependencies.
FROM ghcr.io/astral-sh/uv:0.9.24 AS uv
FROM python:3.11-slim

# Set working directory inside the container
WORKDIR /app

# Copy the dependency metadata first to retain Docker layer caching.
COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock ./

# Install only production dependencies from the committed lock file.
RUN uv sync --frozen --no-dev --no-install-project

# Copy the rest of the application code
COPY . .

ENV PATH="/app/.venv/bin:$PATH"

# Expose the port FastAPI runs on
EXPOSE 8000

# Command to run the app
# host 0.0.0.0 is MANDATORY for Docker to accept outside connections
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
